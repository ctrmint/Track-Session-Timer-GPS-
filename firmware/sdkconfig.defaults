# Baseline board: Waveshare ESP32-S3-Touch-AMOLED-2.41-B (ESP32-S3R8).
# Verified against the attached unit on 2026-08-18: ESP32-S3 QFN56 rev v0.2,
# 8 MB embedded octal PSRAM (AP_3v3), 16 MB quad flash (ef:4018), USB-Serial/JTAG.
# firmware/sdkconfig is generated and git-ignored, so every hardware-critical
# option has to live here to survive a clean clone.

CONFIG_IDF_TARGET="esp32s3"

# 16 MB part. The previous default left this at 2 MB and stranded 14 MB.
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y

# ESP32-S3R8 carries octal PSRAM. docs/UI_FOUNDATION.md places the 96,000-byte
# display buffers in external RAM, which is impossible without this.
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_80M=y

# 240 MHz. The IDF default of 160 MHz leaves no headroom for driving a 540 KB
# RGB565 frame through a 96 KB stripe buffer over PSRAM (docs/UI_FOUNDATION.md).
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y

# 2 MB application partition. LVGL plus the five Montserrat faces below does not
# fit comfortably in the 1 MB single-app default.
CONFIG_PARTITION_TABLE_SINGLE_APP_LARGE=y

# app_main brings up the panel, touch, the card and the track catalog. Parsing a track
# is the expensive part: load_track_definition holds a full TrackDefinition (3.6 KB) in
# its parse state, so the catalog build chain needs about 10 KB. Measured by decoding a
# stack-overflow backtrace at 8 KB. The main task stack is freed when app_main returns,
# so the headroom costs nothing at steady state.
CONFIG_ESP_MAIN_TASK_STACK_SIZE=24576

# LVGL's built-in allocator is a single fixed pool, 64 KB by default, and every LVGL
# allocation comes from it - including rasterised glyph bitmaps. A large digit is tens of
# kilobytes, so only two fit and the glyph cache evicted and re-rasterised on every draw,
# starving the UI task. Using the C library allocator puts those allocations on the
# ESP-IDF heap instead, where SPIRAM_USE_MALLOC can serve them from the 8 MB of PSRAM.
CONFIG_LV_USE_CLIB_MALLOC=y

# Anything above this may come from PSRAM. The default of 16 KB forced glyph bitmaps
# back into internal RAM, which is what made a smaller font thrash just as badly.
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=4096

# Runtime TTF rendering: LVGL's largest built-in font is 48 px, about 3.9 mm on this
# 311 PPI panel, which is far too small for a countdown read from a driving position.
CONFIG_LV_USE_TINY_TTF=y
CONFIG_LV_TINY_TTF_CACHE_GLYPH_CNT=16

CONFIG_LV_BUILD_EXAMPLES=n
CONFIG_LV_BUILD_DEMOS=n
CONFIG_LV_FONT_MONTSERRAT_14=y
CONFIG_LV_FONT_MONTSERRAT_20=y
CONFIG_LV_FONT_MONTSERRAT_24=y
CONFIG_LV_FONT_MONTSERRAT_28=y
# The simulator's lv_conf.h already enables 36; the device build did not, so the two
# had different font sets available.
CONFIG_LV_FONT_MONTSERRAT_36=y
CONFIG_LV_FONT_MONTSERRAT_48=y
